{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "src/index-node.ts",
    "src/types/**/*.d.ts",
    "src/utilities/**/*.ts"
  ],
  "exclude": [
    "src/index-wasm.ts",
    "src/utilities/backendWasm.ts"
  ]
}
