{
  "name": "quantion",
  "version": "0.1.0",
  "description": "quantion: Rust core with WASM bindings",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index-node.js",
  "types": "./lib/index-node.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index-wasm.d.ts",
        "default": "./dist/quantion.js"
      },
      "require": {
        "types": "./lib/index-node.d.ts",
        "default": "./lib/index-node.js"
      },
      "default": {
        "types": "./lib/index-node.d.ts",
        "default": "./lib/index-node.js"
      }
    }
  },
  "files": [
    "dist/**",
    "lib/**",
    "native/**",
    "binding.gyp",
    "src/bridge.cc",
    "src/include/**"
  ],
  "gypfile": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist lib types",
    "check-types": "tsc --noEmit",
    "prepack": "npm run clean && npm run build && npm run tsc-cjs && node scripts/stage-native.mjs",
    "postpack": "node scripts/stage-native.mjs --clean",
    "build": "webpack --config webpack.config.cjs && node scripts/copy-wasm.mjs && tsc --project tsconfig.esm.json",
    "tsc-cjs": "tsc --project tsconfig.cjs.json && node -e \"const fs=require('fs');fs.mkdirSync('lib',{recursive:true});fs.writeFileSync('lib/package.json','{\\n  \\\"type\\\": \\\"commonjs\\\"\\n}\\n')\"",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "dependencies": {
    "ml-spectra-processing": "14.29.4",
    "node-addon-api": "^8.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/webpack": "^5.28.5",
    "jest": "^30.4.2",
    "node-gyp": "^12.4.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
