{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": false,
    "target": "ES2022",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/index-wasm.ts",
    "src/index-node.ts",
    "src/utilities/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}