#!/bin/sh
set -e
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m | tr '[:upper:]' '[:lower:]')
case "$OS" in
  darwin) OS_NAME="macos" ;;
  linux)  OS_NAME="linux" ;;
  *)      echo "Unsupported OS: $OS"; exit 1 ;;
esac
case "$ARCH" in
  arm64|aarch64) ARCH_NAME="arm64" ;;
  x86_64|amd64)  ARCH_NAME="x86_64" ;;
  *)             echo "Unsupported arch: $ARCH"; exit 1 ;;
esac
PLATFORM="${OS_NAME}-${ARCH_NAME}"
ARTIFACTS_ROOT="${MSUTILS_ARTIFACTS_ROOT:-../../artifacts}"
SRC="${ARTIFACTS_ROOT}/${PLATFORM}"
DST="inst/libs/${PLATFORM}"
if [ ! -d "$SRC" ]; then
  echo "msutils: artifacts not found at ${SRC}"
  echo "msutils: set MSUTILS_ARTIFACTS_ROOT to the absolute path of the artifacts folder"
  exit 1
fi
mkdir -p "$DST"
cp -f "$SRC"/* "$DST/"
echo "msutils: staged ${PLATFORM} into ${DST}"